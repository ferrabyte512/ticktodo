<?xml version="1.0" encoding="utf-8"?>
<!--
  Tasks live in the user's cloud account, so nothing is copied by Android backup
  or device-to-device transfer. This avoids restoring one account's local data
  onto a device that signs in with another account.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
