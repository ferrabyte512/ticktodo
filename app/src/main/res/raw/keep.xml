<?xml version="1.0" encoding="utf-8"?>
<!--
  Resources looked up by name at runtime, which the resource shrinker cannot see.
  default_web_client_id is generated by the google-services plugin and read with
  getIdentifier() so that builds without google-services.json still compile.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
